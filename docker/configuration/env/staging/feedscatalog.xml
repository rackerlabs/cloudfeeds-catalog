<?xml version="1.0" encoding="UTF-8"?>
<!--
    Default feedscatalog values for the staging environment.
    This file is baked into the image when CLOUDFEEDS_ENV=staging is used at build time.
-->
<environment>
    <region>GLOBAL</region>
    <vipURL>https://staging.internal.staging.aws.cloudfeeds.rackspace.net</vipURL>
    <externalVipURL>https://staging.external.staging.aws.cloudfeeds.rackspace.net</externalVipURL>
    <prefsSvcVipURL>https://staging.preferences.feeds.rackspacecloud.com</prefsSvcVipURL>
</environment>
